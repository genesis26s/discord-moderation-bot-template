# ============================================================
# Discord Security Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Discord
# ------------------------------------------------------------
# Required. Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: set to your test server's ID to sync slash commands
# instantly. Global sync can take up to 1 hour to propagate.
# Leave blank in production.
DEV_GUILD_ID=


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_PATH=data/bot.db


# ------------------------------------------------------------
# Bot Identity
# ------------------------------------------------------------
BOT_NAME=Security Bot
BOT_DESCRIPTION=Advanced Discord security & management
BOT_STATUS=online
# playing | listening | watching | competing | streaming
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY=your server


# ------------------------------------------------------------
# Branding
# ------------------------------------------------------------
EMBED_COLOR=0x5865F2
SUCCESS_COLOR=0x57F287
ERROR_COLOR=0xED4245
WARNING_COLOR=0xFEE75C
EMBED_FOOTER=Security Bot


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Verification System
# ------------------------------------------------------------
# Verification session lifetime in seconds (default 15 minutes).
VERIFY_SESSION_TIMEOUT=900

# Optional network intelligence provider.
# Leave blank for UNAVAILABLE (recommended unless you have a
# legitimate provider that does not collect end-user PII).
# VERIFY_NETWORK_PROVIDER=
# VERIFY_NETWORK_API_KEY=
